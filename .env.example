# ArogyaSutra Environment Configuration
# 100% Air-Gapped Local Setup (Zero Cloud Dependencies)

# Server Port
PORT=5000

# Client Web Port
CLIENT_PORT=5173

# Ollama Host (Use http://localhost:11434 for local, http://ollama:11434 inside Docker)
OLLAMA_HOST=http://localhost:11434

# Default Local LLM Model (e.g., llama3.2:1b, qwen2.5:1.5b, llama3.2:3b, mistral)
OLLAMA_MODEL=llama3.2:1b

# Local Air-Gapped MongoDB Connection String
# - For Local Node Development: mongodb://localhost:27017/arogyasutra
# - Inside Docker Stack:        mongodb://mongodb:27017/arogyasutra
MONGODB_URI=mongodb://localhost:27017/arogyasutra

# Frontend API Base URL
VITE_API_BASE_URL=http://localhost:5000
